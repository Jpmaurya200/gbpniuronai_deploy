# niuronai SaaS - Environment Configuration Template

# Database & Core Application
MONGO_URL=mongodb://localhost:27017/niuronai
DB_NAME=niuronai
NEXT_PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Super Admin Seed Account (Created on first startup)
SUPER_ADMIN_EMAIL=admin@niuron.ai
SUPER_ADMIN_PASSWORD=Admin@12345

# AI Providers (Choose OpenRouter, Google Gemini, or Emergent)
# Option 1: OpenRouter (Recommended: cheap/free models, no Gemini 15 RPM rate limit)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Optional: 'google/gemini-2.0-flash-001', 'google/gemini-flash-1.5', or free 'meta-llama/llama-3.3-70b-instruct:free'
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Option 2: Direct Google Gemini AI Studio (Free tier rate-limited)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 3: Emergent Universal LLM Gateway
EMERGENT_LLM_KEY=your_emergent_gateway_key
EMERGENT_LLM_URL=https://integrations.emergentagent.com/llm/chat/completions
LLM_MODEL=vertex_ai/gemini-3-flash-preview

# Payments — Razorpay (India-first INR)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google OAuth & Google Business Profile API
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# 32-byte base64 encoded string for AES-256-GCM token encryption at rest
# Generate on Linux/Mac: openssl rand -base64 32
# Generate on Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
GOOGLE_TOKEN_ENCRYPTION_KEY_BASE64=your_32_byte_base64_string

# Transactional Email (Resend / SendGrid / Stub)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_your_resend_api_key
EMAIL_FROM=niuronai <support@niuron.ai>
